---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ResearchSection from '../components/ResearchSection.astro';
import Publications from '../components/Publications.astro';
import CVTimeline from '../components/CVTimeline.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { getPublicProjects } from '../lib/parse-projects';

const projects = getPublicProjects();
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <ResearchSection projects={projects} />
    <Publications papers={projects.published} />
    <CVTimeline />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
