---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import LifeSection from '../components/LifeSection.astro';
import Footer from '../components/Footer.astro';
import { getLifeData } from '../lib/parse-life';

const lifeData = getLifeData();
---

<BaseLayout title="Life | Zylen">
  <Header />
  <main>
    <LifeSection data={lifeData} />
  </main>
  <Footer />
</BaseLayout>
