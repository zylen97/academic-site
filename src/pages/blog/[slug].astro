---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getBlogPosts } from '../../lib/parse-blog';

export function getStaticPaths() {
  const posts = getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Simple markdown to HTML (headings, paragraphs, lists, bold, italic, blockquotes, code)
function mdToHtml(md: string): string {
  return md
    .split('\n\n')
    .map((block) => {
      const trimmed = block.trim();
      if (!trimmed) return '';
      // Headings
      if (trimmed.startsWith('## ')) return `<h2>${trimmed.slice(3)}</h2>`;
      if (trimmed.startsWith('### ')) return `<h3>${trimmed.slice(4)}</h3>`;
      // Blockquote
      if (trimmed.startsWith('> ')) {
        const text = trimmed.split('\n').map(l => l.replace(/^>\s?/, '')).join('<br>');
        return `<blockquote>${text}</blockquote>`;
      }
      // List
      if (trimmed.match(/^- /m)) {
        const items = trimmed.split('\n').filter(l => l.startsWith('- ')).map(l => `<li>${inlineFormat(l.slice(2))}</li>`).join('');
        return `<ul>${items}</ul>`;
      }
      // Paragraph
      return `<p>${inlineFormat(trimmed.replace(/\n/g, ' '))}</p>`;
    })
    .join('\n');
}

function inlineFormat(text: string): string {
  return text
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/`(.+?)`/g, '<code>$1</code>');
}

const htmlContent = mdToHtml(post.content);
---

<BaseLayout title={`${post.title} | Zylen`}>
  <Header />
  <main>
    <article class="py-24">
      <div class="max-w-3xl mx-auto px-6">
        <!-- Back link -->
        <a
          href="/academic-site/blog/"
          class="inline-flex items-center gap-1 text-xs mb-8 transition-colors duration-300"
          style="color: var(--color-muted);"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          Back to Blog
        </a>

        <!-- Header -->
        <h1 class="text-2xl md:text-3xl font-bold leading-tight" style="color: var(--color-text);">
          {post.title}
        </h1>
        <div class="mt-3 flex items-center gap-3">
          <span class="text-xs" style="color: var(--color-muted);">{post.date}</span>
          {post.tags.map((tag) => (
            <span
              class="px-2 py-0.5 text-xs rounded-full"
              style="background: var(--color-surface); color: var(--color-muted); border: 1px solid var(--color-border);"
            >
              {tag}
            </span>
          ))}
        </div>

        <!-- Divider -->
        <div class="mt-8 mb-10 flex items-center gap-3">
          <div class="w-8 h-px" style="background: var(--color-accent);" />
          <div class="w-1.5 h-1.5 rounded-full" style="background: var(--color-accent);" />
        </div>

        <!-- Content -->
        <div class="prose" set:html={htmlContent} />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .prose h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }
  .prose h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }
  .prose p {
    font-size: 0.9rem;
    line-height: 1.8;
    margin-bottom: 1rem;
    color: var(--color-text-secondary);
  }
  .prose ul {
    list-style: none;
    padding-left: 0;
    margin-bottom: 1rem;
  }
  .prose li {
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    padding-left: 1.25rem;
    position: relative;
  }
  .prose li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .prose blockquote {
    border-left: 2px solid var(--color-accent);
    padding-left: 1rem;
    margin-bottom: 1.5rem;
    font-style: italic;
    color: var(--color-muted);
  }
  .prose code {
    font-size: 0.85rem;
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    background: var(--color-surface);
    color: var(--color-accent);
  }
  .prose strong {
    font-weight: 600;
    color: var(--color-text);
  }
</style>
