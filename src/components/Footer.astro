---
const year = new Date().getFullYear();
---

<footer class="py-12 border-t" style="border-color: var(--color-border);">
  <div class="max-w-4xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-2">
    <p class="text-xs" style="color: var(--color-muted);">
      &copy; {year} Zylen. All rights reserved.
    </p>
    <p class="text-xs" style="color: var(--color-muted);">
      Built with <a href="https://astro.build" target="_blank" rel="noopener" class="underline transition-colors duration-300" style="color: var(--color-accent);">Astro</a>
    </p>
  </div>
</footer>
