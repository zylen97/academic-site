---
import type { ProjectGroups } from '../lib/parse-projects';

interface Props {
  projects: ProjectGroups;
}

const { projects } = Astro.props;

const sections = [
  { key: 'published' as const, title: 'Published', subtitle: '已发表', items: projects.published },
  { key: 'underReview' as const, title: 'Under Review', subtitle: '投稿中', items: projects.underReview },
  { key: 'inProgress' as const, title: 'In Progress', subtitle: '撰写中', items: projects.inProgress },
].filter((s) => s.items.length > 0);
---

<section id="research" class="py-24">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex items-center gap-4 mb-16">
      <div class="w-1.5 h-1.5 rounded-full" style="background: var(--color-accent);" />
      <h2 class="text-2xl font-semibold" style="color: var(--color-text);">
        Research Projects
      </h2>
      <div class="flex-1 h-px" style="background: var(--color-border);" />
    </div>

    {sections.map((section) => {
      const showYear = section.key === 'published';
      let counter = 0;
      return (
        <div class="mb-14 last:mb-0">
          <div class="flex items-baseline gap-3 mb-5">
            <h3 class="text-lg font-medium" style="color: var(--color-text);">
              {section.title}
            </h3>
            <span class="text-xs" style="color: var(--color-muted);">
              {section.subtitle} · {section.items.length}
            </span>
          </div>

          <div class="overflow-x-auto rounded-xl" style="border: 1px solid var(--color-border);">
            <table class="research-table w-full text-sm">
              <thead>
                <tr style="background: var(--color-surface);">
                  <th class="px-4 py-3 text-left font-medium w-8" style="color: var(--color-muted);">#</th>
                  <th class="px-4 py-3 text-left font-medium" style="color: var(--color-muted);">Title</th>
                  <th class="px-4 py-3 text-left font-medium whitespace-nowrap" style="color: var(--color-muted);">Method</th>
                  <th class="px-4 py-3 text-left font-medium whitespace-nowrap" style="color: var(--color-muted);">
                    {showYear ? 'Journal' : 'Target Journal'}
                  </th>
                  {showYear && <th class="px-4 py-3 text-center font-medium w-16" style="color: var(--color-muted);">Year</th>}
                  <th class="px-4 py-3 text-center font-medium w-20" style="color: var(--color-muted);">Role</th>
                </tr>
              </thead>
              <tbody>
                {section.items.map((project) => {
                  counter++;
                  const roleLabel = project.role === '一作' ? 'First' : project.role === '通讯' ? 'Corr.' : 'Second';
                  const roleColor = project.role === '一作' ? 'var(--color-accent)' : project.role === '通讯' ? 'var(--color-accent-secondary)' : 'var(--color-muted)';
                  return (
                    <tr class="border-t transition-colors duration-200" style="border-color: var(--color-border);">
                      <td class="px-4 py-3.5 tabular-nums" style="color: var(--color-muted);">{counter}</td>
                      <td class="px-4 py-3.5 leading-relaxed" style="color: var(--color-text);">{project.title}</td>
                      <td class="px-4 py-3.5 whitespace-nowrap">
                        <span class="inline-block px-2 py-0.5 text-xs rounded-full" style="background: var(--color-accent); color: white; opacity: 0.85;">
                          {project.method}
                        </span>
                      </td>
                      <td class="px-4 py-3.5 whitespace-nowrap text-xs" style="color: var(--color-muted);">{project.journal}</td>
                      {showYear && <td class="px-4 py-3.5 text-center tabular-nums" style="color: var(--color-muted);">{project.year}</td>}
                      <td class="px-4 py-3.5 text-center">
                        <span class="text-xs font-medium" style={`color: ${roleColor};`}>{roleLabel}</span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .research-table tr:hover {
    background: var(--color-surface);
  }
</style>
